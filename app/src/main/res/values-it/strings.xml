    <string name="shizuku_info_title">Informazioni su Shizuku</string>
    <string name="shizuku_info_body_1">Shizuku è un\u2019app open source separata che consente ad altre app di usare i permessi di livello ADB di Android senza root. È così che app come questa possono fare cose che Android normalmente blocca alle app normali.</string>
    <string name="shizuku_info_unlocks">Con Shizuku connesso, Oh Shoot può:</string>

    <string name="shizuku_info_unlock_2">Gestire davvero le app in background, non solo chiederlo gentilmente</string>
    <string name="shizuku_info_unlock_3">Modificare impostazioni sicure del sistema senza computer</string>
    <string name="shizuku_info_body_2">Shizuku è completamente opzionale. Tutto in questa app funziona senza — Shizuku rende solo le funzioni avanzate più veloci e affidabili. Puoi disconnetterlo in qualsiasi momento fermandolo nella sua app.</string>

    <!-- Controlli avanzati delle prestazioni (solo Shizuku) -->
    <string name="perf_enhanced_title">Controlli avanzati</string>
    <string name="perf_enhanced_subtitle">Queste opzioni usano Shizuku per modificare direttamente le impostazioni di sistema. Restano attive finché non le disattivi o ripristini i valori predefiniti.</string>

    <string name="perf_anim_title">Velocità delle animazioni</string>
    <string name="perf_anim_desc">Le animazioni lente fanno sembrare il telefono lento. Accelerarle lo rende più scattante senza toccare le prestazioni.</string>
    <string name="perf_anim_speed_off">Disattivato (istantaneo)</string>
    <string name="perf_anim_speed_half">Veloce (0,5×)</string>
    <string name="perf_anim_speed_normal">Normale (1×)</string>

    <string name="perf_bg_limit_title">Limite processi in background</string>
    <string name="perf_bg_limit_desc">Quante app in background Android può tenere in memoria. Meno significa più RAM libera, ma le app si ricaricano più spesso quando ci torni.</string>
    <string name="perf_bg_limit_default">Predefinito di sistema</string>
    <string name="perf_bg_limit_standard">Standard</string>
    <string name="perf_bg_limit_1">Al massimo 1 processo</string>
    <string name="perf_bg_limit_2">Al massimo 2 processi</string>
    <string name="perf_bg_limit_3">Al massimo 3 processi</string>
    <string name="perf_bg_limit_4">Al massimo 4 processi</string>

    <string name="perf_dont_keep_title">Non mantenere le attività</string>
    <string name="perf_dont_keep_desc">Distrugge ogni attività appena la lasci. Risparmia RAM, ma le schermate si ricaricano quando torni indietro.</string>

    <string name="perf_kill_all_title">Pulisci processi in background</string>
    <string name="perf_kill_all_desc">Termina tutti i processi in background che Android può chiudere in sicurezza. App in primo piano, musica, navigazione e chiamate non vengono mai toccate.</string>
    <string name="perf_kill_all_button">Pulisci background</string>
