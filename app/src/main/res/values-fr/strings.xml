    <string name="shizuku_info_title">À propos de Shizuku</string>
    <string name="shizuku_info_body_1">Shizuku est une app open source distincte qui permet à d\u2019autres apps d\u2019utiliser les permissions de niveau ADB d\u2019Android sans nécessiter de root. C\u2019est ainsi que des apps comme celle-ci peuvent faire des choses qu\u2019Android bloque normalement aux apps ordinaires.</string>
    <string name="shizuku_info_unlocks">Avec Shizuku connecté, Oh Shoot peut :</string>

    <string name="shizuku_info_unlock_2">Vraiment gérer les apps en arrière-plan, pas seulement demander gentiment</string>
    <string name="shizuku_info_unlock_3">Modifier des réglages système sécurisés sans ordinateur</string>
    <string name="shizuku_info_body_2">Shizuku est totalement facultatif. Tout dans cette app fonctionne sans lui — Shizuku rend simplement les fonctions avancées plus rapides et fiables. Vous pouvez le déconnecter à tout moment en l\u2019arrêtant dans sa propre app.</string>



    <!-- Contrôles de performance avancés (Shizuku uniquement) -->
    <string name="perf_enhanced_title">Contrôles avancés</string>
    <string name="perf_enhanced_subtitle">Ces options utilisent Shizuku pour modifier directement les paramètres système. Elles restent actives jusqu\'à ce que vous les désactiviez ou restauriez les valeurs par défaut.</string>

    <string name="perf_anim_title">Vitesse d\'animation</string>
    <string name="perf_anim_desc">Des animations lentes donnent l\'impression que le téléphone est lent. Les accélérer le rend plus fluide sans toucher aux performances.</string>
    <string name="perf_anim_speed_off">Désactivé (instantané)</string>
    <string name="perf_anim_speed_half">Rapide (0,5×)</string>
    <string name="perf_anim_speed_normal">Normal (1×)</string>

    <string name="perf_bg_limit_title">Limite de processus en arrière-plan</string>
    <string name="perf_bg_limit_desc">Combien d\'apps en arrière-plan Android peut garder en mémoire. Moins signifie plus de RAM libre, mais les apps se rechargent plus souvent quand vous y revenez.</string>
    <string name="perf_bg_limit_default">Par défaut du système</string>
    <string name="perf_bg_limit_standard">Standard</string>
    <string name="perf_bg_limit_1">Au plus 1 processus</string>
    <string name="perf_bg_limit_2">Au plus 2 processus</string>
    <string name="perf_bg_limit_3">Au plus 3 processus</string>
    <string name="perf_bg_limit_4">Au plus 4 processus</string>

    <string name="perf_dont_keep_title">Ne pas conserver les activités</string>
    <string name="perf_dont_keep_desc">Détruit chaque activité dès que vous la quittez. Économise de la RAM, mais les écrans se rechargent quand vous revenez.</string>

    <string name="perf_kill_all_title">Effacer les processus en arrière-plan</string>
    <string name="perf_kill_all_desc">Termine tous les processus en arrière-plan qu\'Android peut fermer en toute sécurité. Les apps au premier plan, la musique, la navigation et les appels ne sont jamais touchés.</string>
    <string name="perf_kill_all_button">Effacer l\'arrière-plan</string>
    <string name="perf_kill_all_done">Processus en arrière-plan effacés</string>

    <string name="perf_reset_enhanced">Tout restaurer aux valeurs par défaut</string>
    <string name="perf_reset_enhanced_done">Paramètres avancés restaurés aux valeurs par défaut</string>

    <string name="perf_enhanced_unavailable">Les contrôles avancés nécessitent Shizuku. Connectez-le dans l\'onglet Autorisations pour débloquer ces options.</string>

    <string name="shizuku_body_ready">Toutes les fonctions avancées sont actives.</string>
    <string name="shizuku_info_unlock_1">Arrêter les apps de manière fiable — le même arrêt que celui utilisé par les Paramètres</string>

    <string name="widget_help_title">Synchronisation des widgets</string>
    <string name="widget_help_body">Les widgets peuvent avoir quelques secondes de retard sur un changement de thème ou de langue.\n\nSi un widget semble obsolète, ouvrez et fermez l\'application une fois, ou supprimez puis rajoutez le widget pour le rafraîchir immédiatement.</string>
