    <string name="a11y_service_label">Nettoyeur de cache automatique</string>
    <string name="a11y_service_summary">Automatise le nettoyage du cache dans les Réglages</string>
    <string name="a11y_service_description">Automatise les touchers nécessaires pour vider le cache d\'autres apps. Ne s\'exécute que lorsque vous lancez un nettoyage depuis Oh Shoot — le service ne fait rien autrement et ne lit ni ne stocke aucune donnée.</string>

    <string name="a11y_onboarding_title">Nettoyage automatique disponible</string>
    <string name="a11y_onboarding_subtitle">Configuration unique, sans ordinateur</string>
    <string name="a11y_onboarding_explain">Activez le service « Nettoyeur de cache automatique » dans Accessibilité. Oh Shoot naviguera alors dans les Réglages à votre place et videra le cache de chaque app automatiquement — aucun toucher nécessaire. Le service ne fait rien tant que vous ne lancez pas un nettoyage depuis l\'app.</string>
    <string name="a11y_onboarding_action">Activer dans Accessibilité</string>
    <string name="a11y_onboarding_privacy">Confidentialité : le service ne s\'exécute que pendant un nettoyage que vous lancez. Il ne lit jamais le contenu de l\'écran et ne stocke rien. Vous pouvez le désactiver à tout moment dans Réglages → Accessibilité.</string>

