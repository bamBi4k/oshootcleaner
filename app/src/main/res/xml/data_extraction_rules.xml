<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Include only our prefs file -->
        <include domain="sharedpref" path="oh_shoot_prefs.xml"/>
        <include domain="sharedpref" path="oh_shoot_alpha.xml"/>
        <!-- Exclude anything sensitive that might creep in -->
        <exclude domain="sharedpref" path="com.google.android.gms.appid.xml"/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="oh_shoot_prefs.xml"/>
        <include domain="sharedpref" path="oh_shoot_alpha.xml"/>
    </device-transfer>
</data-extraction-rules>