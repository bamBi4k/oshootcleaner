    <string name="a11y_service_label">Limpador automático de cache</string>
    <string name="a11y_service_summary">Automatiza a limpeza de cache nas Configurações</string>
    <string name="a11y_service_description">Automatiza os toques necessários para limpar a cache de outros apps. Só é executado quando você inicia uma limpeza pelo Oh Shoot — o serviço não faz nada caso contrário e nunca lê nem armazena dados.</string>

    <string name="a11y_onboarding_title">Limpeza automática disponível</string>
    <string name="a11y_onboarding_subtitle">Configuração única, sem computador</string>
    <string name="a11y_onboarding_explain">Ative o serviço \"Limpador automático de cache\" em Acessibilidade. O Oh Shoot vai navegar pelas Configurações em seu nome e limpar a cache de cada app automaticamente — sem toques. O serviço não faz nada a menos que você inicie uma limpeza pelo app.</string>
    <string name="a11y_onboarding_action">Ativar em Acessibilidade</string>
    <string name="a11y_onboarding_privacy">Privacidade: o serviço só é executado durante uma limpeza que você inicia. Nunca lê o conteúdo da tela nem armazena nada. Você pode desativá-lo a qualquer momento em Configurações → Acessibilidade.</string>

