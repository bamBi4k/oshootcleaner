    <string name="shizuku_body_not_installed">Instala o Shizuku para desbloquear uma limpeza de cache mais rápida, uma gestão real das apps em segundo plano e definições seguras sem comandos ADB.</string>
    <string name="shizuku_body_not_running">O Shizuku está instalado mas não iniciado. Abre a app Shizuku e inicia-a através de depuração sem fios ou ADB.</string>
    <string name="shizuku_body_permission_required">O Shizuku está em execução. Concede permissão a esta app para o usar.</string>


    <string name="shizuku_action_install">Instalar Shizuku</string>
    <string name="shizuku_action_open">Abrir Shizuku</string>
    <string name="shizuku_action_grant">Conceder permissão</string>

    <string name="shizuku_info_title">Sobre o Shizuku</string>
    <string name="shizuku_info_body_1">O Shizuku é uma app open source separada que permite a outras apps usar as permissões de nível ADB do Android sem precisar de root. É assim que apps como esta conseguem fazer coisas que o Android normalmente bloqueia às apps comuns.</string>
    <string name="shizuku_info_unlocks">Com o Shizuku ligado, o Oh Shoot pode:</string>

    <string name="shizuku_info_unlock_2">Gerir mesmo as apps em segundo plano, não apenas pedir com educação</string>
    <string name="shizuku_info_unlock_3">Alterar definições seguras do sistema sem computador</string>
    <string name="shizuku_info_body_2">O Shizuku é completamente opcional. Tudo nesta app funciona sem ele — o Shizuku apenas torna as funcionalidades avançadas mais rápidas e fiáveis. Podes desligá-lo a qualquer momento, parando-o na sua própria app.</string>


    <!-- Controlos avançados de desempenho (apenas Shizuku) -->
    <string name="perf_enhanced_title">Controlos avançados</string>
    <string name="perf_enhanced_subtitle">Estas opções usam o Shizuku para alterar diretamente as definições do sistema. Permanecem ativas até as desativares ou restaurares os valores predefinidos.</string>

    <string name="perf_anim_title">Velocidade das animações</string>
    <string name="perf_anim_desc">Animações lentas fazem o telemóvel parecer lento. Acelerá-las torna-o mais ágil sem tocar no desempenho.</string>
    <string name="perf_anim_speed_off">Desligado (instantâneo)</string>
    <string name="perf_anim_speed_half">Rápido (0,5×)</string>
    <string name="perf_anim_speed_normal">Normal (1×)</string>

    <string name="perf_bg_limit_title">Limite de processos em segundo plano</string>
    <string name="perf_bg_limit_desc">Quantas apps em segundo plano o Android pode manter na memória. Menos significa mais RAM livre, mas as apps recarregam mais vezes quando voltas a elas.</string>
    <string name="perf_bg_limit_default">Predefinido do sistema</string>
    <string name="perf_bg_limit_standard">Padrão</string>
    <string name="perf_bg_limit_1">No máximo 1 processo</string>
    <string name="perf_bg_limit_2">No máximo 2 processos</string>
    <string name="perf_bg_limit_3">No máximo 3 processos</string>
    <string name="perf_bg_limit_4">No máximo 4 processos</string>

    <string name="perf_dont_keep_title">Não manter atividades</string>
    <string name="perf_dont_keep_desc">Destrói cada atividade assim que a abandonas. Poupa RAM, mas os ecrãs recarregam quando voltas atrás.</string>

    <string name="perf_kill_all_title">Limpar processos em segundo plano</string>
    <string name="perf_kill_all_desc">Termina todos os processos em segundo plano que o Android pode fechar em segurança. Apps em primeiro plano, música, navegação e chamadas nunca são afetadas.</string>
    <string name="perf_kill_all_button">Limpar segundo plano</string>
    <string name="perf_kill_all_done">Processos em segundo plano limpos</string>

    <string name="perf_reset_enhanced">Restaurar tudo para os valores predefinidos</string>
    <string name="perf_reset_enhanced_done">Definições avançadas restauradas para os valores predefinidos</string>

    <string name="perf_enhanced_unavailable">Os controlos avançados precisam do Shizuku. Liga-o no separador de permissões para desbloquear estas opções.</string>

    <string name="shizuku_body_ready">Todas as funcionalidades avançadas estão ativas.</string>
    <string name="shizuku_info_unlock_1">Parar apps de forma fiável — a mesma paragem usada pelas Definições</string>

    <string name="widget_help_title">Sincronização de widgets</string>
    <string name="widget_help_body">Os widgets podem ficar alguns segundos atrás de uma alteração de tema ou idioma.\n\nSe um widget parecer desatualizado, abre e fecha a app uma vez, ou remove e adiciona novamente o widget para o atualizar imediatamente.</string>

