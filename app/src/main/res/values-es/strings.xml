    <string name="a11y_service_label">Limpiador automático de caché</string>
    <string name="a11y_service_summary">Automatiza la limpieza de caché en Ajustes</string>
    <string name="a11y_service_description">Automatiza los toques necesarios para borrar la caché de otras apps. Solo se ejecuta cuando inicias una limpieza desde Oh Shoot — el servicio no hace nada en caso contrario y nunca lee ni almacena datos.</string>

    <string name="a11y_onboarding_title">Limpieza automática disponible</string>
    <string name="a11y_onboarding_subtitle">Configuración única, sin ordenador</string>
    <string name="a11y_onboarding_explain">Activa el servicio \"Limpiador automático de caché\" en Accesibilidad. Oh Shoot navegará por Ajustes en tu nombre y borrará la caché de cada app automáticamente — sin toques. El servicio no hace nada a menos que inicies una limpieza desde la app.</string>
    <string name="a11y_onboarding_action">Activar en Accesibilidad</string>
    <string name="a11y_onboarding_privacy">Privacidad: el servicio solo se ejecuta durante una limpieza que tú inicias. Nunca lee el contenido de la pantalla ni almacena nada. Puedes desactivarlo en cualquier momento en Ajustes → Accesibilidad.</string>

