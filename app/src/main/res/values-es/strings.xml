    <string name="shizuku_body_not_installed">Instala Shizuku para desbloquear una limpieza de caché más rápida, una gestión real de las apps en segundo plano y ajustes seguros sin necesidad de comandos ADB.</string>
    <string name="shizuku_body_not_running">Shizuku está instalado pero no iniciado. Abre la app Shizuku e iníciala mediante depuración inalámbrica o ADB.</string>
    <string name="shizuku_body_permission_required">Shizuku está en ejecución. Concede permiso a esta app para usarlo.</string>


    <string name="shizuku_action_install">Instalar Shizuku</string>
    <string name="shizuku_action_open">Abrir Shizuku</string>
    <string name="shizuku_action_grant">Conceder permiso</string>

    <string name="shizuku_info_title">Acerca de Shizuku</string>
    <string name="shizuku_info_body_1">Shizuku es una app de código abierto independiente que permite a otras apps usar los permisos de nivel ADB de Android sin necesidad de root. Así es como apps como esta pueden hacer cosas que Android normalmente bloquea a las apps normales.</string>
    <string name="shizuku_info_unlocks">Con Shizuku conectado, Oh Shoot puede:</string>

    <string name="shizuku_info_unlock_2">Gestionar las apps en segundo plano de verdad, no solo pedirlo amablemente</string>
    <string name="shizuku_info_unlock_3">Cambiar ajustes seguros del sistema sin un ordenador</string>
    <string name="shizuku_info_body_2">Shizuku es completamente opcional. Todo en esta app funciona sin él — Shizuku solo hace que las funciones mejoradas sean más rápidas y fiables. Puedes desconectarlo en cualquier momento deteniéndolo en su propia app.</string>


    <!-- Controles mejorados de rendimiento (solo Shizuku) -->
    <string name="perf_enhanced_title">Controles mejorados</string>
    <string name="perf_enhanced_subtitle">Estas opciones usan Shizuku para cambiar ajustes del sistema directamente. Permanecen activas hasta que las desactives o restaures los valores predeterminados.</string>

    <string name="perf_anim_title">Velocidad de animación</string>
    <string name="perf_anim_desc">Las animaciones lentas hacen que el teléfono parezca lento. Acelerarlas lo hace sentir más rápido sin tocar el rendimiento.</string>
    <string name="perf_anim_speed_off">Desactivado (instantáneo)</string>
    <string name="perf_anim_speed_half">Rápido (0,5×)</string>
    <string name="perf_anim_speed_normal">Normal (1×)</string>

    <string name="perf_bg_limit_title">Límite de procesos en segundo plano</string>
    <string name="perf_bg_limit_desc">Cuántas apps en segundo plano puede mantener Android en memoria. Menos significa más RAM libre, pero las apps se recargan más a menudo al volver a ellas.</string>
    <string name="perf_bg_limit_default">Predeterminado del sistema</string>
    <string name="perf_bg_limit_standard">Estándar</string>
    <string name="perf_bg_limit_1">Como máximo 1 proceso</string>
    <string name="perf_bg_limit_2">Como máximo 2 procesos</string>
    <string name="perf_bg_limit_3">Como máximo 3 procesos</string>
    <string name="perf_bg_limit_4">Como máximo 4 procesos</string>

    <string name="perf_dont_keep_title">No conservar actividades</string>
    <string name="perf_dont_keep_desc">Destruye cada actividad en cuanto la abandonas. Ahorra RAM, pero tendrás que volver a cargar pantallas al regresar.</string>

    <string name="perf_kill_all_title">Limpiar procesos en segundo plano</string>
    <string name="perf_kill_all_desc">Termina todos los procesos en segundo plano que Android puede cerrar de forma segura. Las apps en primer plano, música, navegación y llamadas nunca se ven afectadas.</string>
    <string name="perf_kill_all_button">Limpiar segundo plano</string>
    <string name="perf_kill_all_done">Procesos en segundo plano limpiados</string>

    <string name="perf_reset_enhanced">Restaurar todo a los valores predeterminados</string>
    <string name="perf_reset_enhanced_done">Ajustes mejorados restaurados a los valores predeterminados</string>

    <string name="perf_enhanced_unavailable">Los controles mejorados necesitan Shizuku. Conéctalo en la pestaña de permisos para desbloquear estas opciones.</string>

    <string name="shizuku_body_ready">Todas las funciones mejoradas están activas.</string>
    <string name="shizuku_info_unlock_1">Detener apps de forma fiable — el mismo detenido que usa Ajustes</string>

    <string name="widget_help_title">Sincronización de widgets</string>
    <string name="widget_help_body">Los widgets pueden tardar unos segundos en reflejar un cambio de tema o idioma.\n\nSi un widget se ve desactualizado, abre y cierra la app una vez, o elimina y vuelve a añadir el widget para actualizarlo al instante.</string>
