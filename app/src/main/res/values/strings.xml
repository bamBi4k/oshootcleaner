    <string name="shizuku_info_title">About Shizuku</string>
    <string name="shizuku_info_body_1">Shizuku is a separate, open-source app that lets other apps use Android\u2019s ADB-level permissions without needing root. It\u2019s how apps like this one can do things Android normally blocks for regular apps.</string>
    <string name="shizuku_info_unlocks">With Shizuku connected, Oh Shoot can:</string>

    <string name="shizuku_info_unlock_2">Manage background apps properly, not just politely ask</string>
    <string name="shizuku_info_unlock_3">Change secure system settings without a computer</string>
    <string name="shizuku_info_body_2">Shizuku is completely optional. Everything in this app works without it — Shizuku just makes the enhanced features faster and more reliable. You can disconnect at any time by stopping Shizuku in its own app.</string>


    <!-- Enhanced Performance controls (Shizuku only) -->
    <string name="perf_enhanced_title">Enhanced Controls</string>
    <string name="perf_enhanced_subtitle">These options use Shizuku to change system settings directly. They stay active until you turn them off or restore defaults.</string>

    <string name="perf_anim_title">Animation Speed</string>
    <string name="perf_anim_desc">Slower animations make the phone feel sluggish. Speeding them up makes it feel faster without touching performance.</string>
    <string name="perf_anim_speed_off">Off (instant)</string>
    <string name="perf_anim_speed_half">Fast (0.5×)</string>
    <string name="perf_anim_speed_normal">Normal (1×)</string>

    <string name="perf_bg_limit_title">Background Process Limit</string>
    <string name="perf_bg_limit_desc">How many background apps Android is allowed to keep in memory. Fewer means more free RAM but apps reload more often when you return to them.</string>
    <string name="perf_bg_limit_default">System default</string>
    <string name="perf_bg_limit_standard">Standard</string>
    <string name="perf_bg_limit_1">At most 1 process</string>
    <string name="perf_bg_limit_2">At most 2 processes</string>
    <string name="perf_bg_limit_3">At most 3 processes</string>
    <string name="perf_bg_limit_4">At most 4 processes</string>

    <string name="perf_dont_keep_title">Don\'t Keep Activities</string>
    <string name="perf_dont_keep_desc">Destroy every activity as soon as you leave it. Saves RAM at the cost of having to reload screens when you go back.</string>

    <string name="perf_kill_all_title">Clear Background Processes</string>
    <string name="perf_kill_all_desc">Ends every background process Android is allowed to safely end. Foreground apps, music, navigation, and calls are never touched.</string>
    <string name="perf_kill_all_button">Clear Background</string>
    <string name="perf_kill_all_done">Background processes cleared</string>

