    <string name="perf_reset_enhanced_done">Enhanced settings restored to defaults</string>

    <string name="perf_enhanced_unavailable">Enhanced controls need Shizuku. Connect it in the Permissions tab to unlock these options.</string>

    <string name="widget_help_title">Widget sync</string>
    <string name="widget_help_body">Widgets can lag a few seconds behind a theme or language change.\n\nIf a widget looks stale, open and close the app once, or remove and re-add the widget for an immediate refresh.</string>

